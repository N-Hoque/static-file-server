load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

gazelle(name = "gazelle")

go_library(
    name = "static-file-server_lib",
    srcs = ["main.go"],
    importpath = "github.com/N-Hoque/static-file-server",
    visibility = ["//visibility:private"],
    deps = ["//pkg/cli"],
)

go_binary(
    name = "static-file-server",
    embed = [":static-file-server_lib"],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "serve_layer",
    srcs = [":static-file-server"],
    mode = "0755",
    package_dir = "/",
)

oci_image(
    name = "serve_image",
    architecture = "",
    base = "@distroless_base",
    tars = [":serve_layer"],
)

oci_push(
    name = "push",
    image = ":serve_image",
    remote_tags = ["latest"],
    repository = "docker.io/nhoque/static-file-server",
)
