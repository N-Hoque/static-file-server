load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_binary")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

gazelle(name = "gazelle")

go_binary(
    name = "serve",
    srcs = ["main.go"],
    visibility = ["//visibility:public"],
    deps = ["//pkg/cli"],
)

pkg_tar(
    name = "serve_layer",
    srcs = [":serve"],
    mode = "0755",
    package_dir = "/",
)

oci_image(
    name = "serve_image",
    base = "@distroless_base",
    entrypoint = ["/serve"],
    tars = [":serve_layer"],
    # Optionally set architecture here, or rely on --platforms during build.
    # architecture = "amd64",
)

oci_push(
    name = "push",
    image = ":serve_image",
    remote_tags = ["{STABLE_DOCKER_TAG}"],
    # Resolved at runtime via --stamp + workspace_status_command.
    repository = "{STABLE_DOCKER_IMAGE}",
)
