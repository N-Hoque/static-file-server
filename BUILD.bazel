# Let Gazelle generate/maintain BUILD files for your Go packages.
load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "go_binary", "go_library")

# Run: `bazel run //:gazelle` whenever you add/rename Go files or deps.
gazelle(name = "gazelle")

go_library(
    name = "static-file-server_lib",
    srcs = ["main.go"],
    importpath = "github.com/N-Hoque/static-file-server",
    visibility = ["//visibility:private"],
    deps = ["//pkg/cli"],
)

go_binary(
    name = "static-file-server",
    embed = [":static-file-server_lib"],
    visibility = ["//visibility:public"],
)
